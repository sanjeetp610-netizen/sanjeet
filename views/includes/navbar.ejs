<style>
    .site-navbar {
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.97), rgba(247, 249, 252, 0.94));
        box-shadow: 0 12px 35px rgba(23, 32, 51, 0.08);
        backdrop-filter: blur(16px);
    }

    .navbar-inner {
        min-height: 78px;
        max-width: 1480px;
    }

    .brand-mark {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        color: #172033;
        font-size: 1.16rem;
        font-weight: 800;
        letter-spacing: -0.04em;
        white-space: nowrap;
    }

    .brand-mark i {
        color: #e85d4a;
        font-size: 1.55rem;
        filter: drop-shadow(0 5px 8px rgba(232, 93, 74, 0.2));
    }

    .brand-mark:hover {
        color: #e85d4a;
    }

    .nav-link {
        border-radius: 999px;
        color: #4b5567;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 0.62rem 0.85rem !important;
        transition: color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .nav-link:hover {
        background: #fff1ed;
        color: #c94839;
        transform: translateY(-1px);
    }

    .search-wrap {
        flex: 1 1 420px;
        max-width: 520px;
    }

    .search-shell {
        position: relative;
        width: 100%;
    }

    .search-inp {
        width: 100%;
        border: 1px solid #dce2eb;
        border-radius: 999px;
        padding: 0.78rem 7rem 0.78rem 2.9rem;
        background: #fff;
        box-shadow: 0 5px 18px rgba(23, 32, 51, 0.06);
    }

    .search-inp:focus {
        border-color: #e85d4a;
        box-shadow: 0 0 0 4px rgba(232, 93, 74, 0.14), 0 8px 22px rgba(23, 32, 51, 0.08);
    }

    .search-icon {
        position: absolute;
        left: 1.05rem;
        top: 50%;
        z-index: 2;
        color: #8a93a3;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .search-btn {
        position: absolute;
        right: 0.35rem;
        top: 0.35rem;
        bottom: 0.35rem;
        border: 0;
        border-radius: 999px;
        padding: 0 1.15rem;
        background: #e85d4a;
        color: #fff;
        font-size: 0.82rem;
        font-weight: 800;
        transition: background 160ms ease, transform 160ms ease;
    }

    .search-btn:hover {
        background: #c94839;
        color: #fff;
        transform: translateY(-1px);
    }

    .owner-link {
        background: #172033;
        color: #fff !important;
    }

    .owner-link:hover {
        background: #e85d4a;
        color: #fff !important;
    }

    @media (max-width: 991.98px) {
        .navbar-inner {
            min-height: 70px;
        }

        .navbar-collapse {
            padding: 0.75rem 0 0.5rem;
        }

        .search-wrap {
            max-width: none;
            margin: 0.5rem 0;
        }

        .navbar-nav .nav-link {
            display: inline-block;
            margin: 0.15rem 0;
        }
    }

    @media (max-width: 575.98px) {
        .brand-mark {
            font-size: 1.05rem;
        }

        .search-inp {
            padding-left: 2.65rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg site-navbar border-bottom sticky-top">
    <div class="container-fluid navbar-inner px-3 px-lg-4">
        <a class="navbar-brand brand-mark" href="/listings" aria-label="Wanderlust home">
            <i class="fa-regular fa-compass"></i>
            <span>Wanderlust</span>
        </a>

        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav ms-lg-3">
                <a class="nav-link" href="/listings"><i class="fa-solid fa-compass me-1"></i>Explore</a>
            </div>

            <div class="search-wrap mx-lg-auto">
                <form class="search-shell" role="search" action="/listings" method="GET">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input class="form-control search-inp" name="q" type="search" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" placeholder="Search stays, cities, or countries" aria-label="Search listings">
                    <button class="search-btn" type="submit">Search</button>
                </form>
            </div>

            <div class="navbar-nav ms-lg-auto align-items-lg-center">
                <a class="nav-link" href="/listings/new"><i class="fa-solid fa-house me-1"></i>Airbnb your home</a>
                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup"><b>Sign up</b></a>
                    <a class="nav-link owner-link" href="/login"><b>Log in</b></a>
                <% } %>
                <% if(currUser) { %>
                    <a class="nav-link owner-link" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i><b>Log out</b></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
