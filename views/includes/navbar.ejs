<style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

    .site-navbar {
        background: #ffffff;
        box-shadow: 0 2px 14px rgba(34, 34, 34, 0.08);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .navbar-inner {
        min-height: 72px;
        max-width: 1480px;
    }

    .nav-link {
        border-radius: 10px;
        color: #222222;
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.2;
        padding: 0.72rem 0.8rem !important;
        white-space: nowrap;
        transition: color 160ms ease, background 160ms ease;
    }

    .nav-link:hover {
        background: #f7f7f7;
        color: #ff385c;
    }

    .feature-link {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        font-size: 1rem;
        font-weight: 700;
    }

    .feature-link i {
        flex: 0 0 auto;
        color: #ff385c;
        font-size: 1.2rem;
        line-height: 1;
    }

    .navbar-collapse {
        align-items: center;
    }

    .search-wrap {
        flex: 1 1 420px;
        max-width: 560px;
        min-width: 0;
    }

    .search-shell {
        position: relative;
        width: 100%;
    }

    .search-inp {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dddddd;
        border-radius: 12px;
        padding: 0.7rem 6.5rem 0.7rem 2.75rem;
        background: #ffffff;
        box-shadow: 0 2px 8px rgba(34, 34, 34, 0.07);
    }

    .search-inp:focus {
        border-color: #ff385c;
        box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.14);
    }

    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        z-index: 2;
        color: #717171;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .search-btn {
        position: absolute;
        right: 0.35rem;
        top: 0.35rem;
        bottom: 0.35rem;
        border: 0;
        border-radius: 8px;
        padding: 0 1rem;
        background: #ff385c;
        color: #ffffff;
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
        transition: background 160ms ease;
    }

    .search-btn:hover {
        background: #e31c5f;
        color: #ffffff;
    }

    .owner-link {
        background: #222222;
        color: #ffffff !important;
    }

    .owner-link:hover {
        background: #ff385c;
        color: #ffffff !important;
    }

    @media (max-width: 991.98px) {
        .navbar-inner {
            min-height: 68px;
        }

        .navbar-toggler {
            padding: 0.35rem 0.55rem;
        }

        .navbar-collapse {
            padding: 0.65rem 0 0.55rem;
        }

        .navbar-collapse .navbar-nav {
            width: 100%;
        }

        .search-wrap {
            width: 100%;
            max-width: none;
            margin: 0.5rem 0;
        }

        .navbar-nav .nav-link {
            display: flex;
            width: 100%;
            margin: 0.12rem 0;
        }
    }

    @media (max-width: 575.98px) {
        .navbar-inner {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .feature-link {
            font-size: 0.98rem;
        }

        .search-inp {
            padding-left: 2.55rem;
            padding-right: 6rem;
        }

        .search-btn {
            padding: 0 0.85rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg site-navbar border-bottom sticky-top">
    <div class="container-fluid navbar-inner px-3 px-lg-4">
        <button class="navbar-toggler border-0 shadow-none ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link feature-link" href="/listings"><i class="fa-regular fa-compass" aria-hidden="true"></i><span>Explore</span></a>
            </div>

            <div class="search-wrap mx-lg-auto">
                <form class="search-shell" role="search" action="/listings" method="GET">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input class="form-control search-inp" name="q" type="search" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" placeholder="Search stays, cities, or countries" aria-label="Search listings">
                    <button class="search-btn" type="submit">Search</button>
                </form>
            </div>

            <div class="navbar-nav ms-lg-auto align-items-lg-center">
                <a class="nav-link feature-link" href="/listings/new"><i class="fa-solid fa-house" aria-hidden="true"></i><span>Airbnb your home</span></a>
                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup"><b>Sign up</b></a>
                    <a class="nav-link owner-link" href="/login"><b>Log in</b></a>
                <% } %>
                <% if(currUser) { %>
                    <a class="nav-link owner-link" href="/logout"><b>Log out</b></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
