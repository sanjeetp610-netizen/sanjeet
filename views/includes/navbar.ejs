<style>
    .site-navbar {
        background: #ffffff;
        box-shadow: 0 2px 14px rgba(34, 34, 34, 0.08);
        font-family: 'Plus Jakarta Sans', sans-serif;
    }

    .navbar-inner {
        min-height: 72px;
        max-width: 1480px;
    }

    .nav-link {
        border-radius: 999px;
        color: #222222;
        font-size: 0.9rem;
        font-weight: 700;
        padding: 0.72rem 0.95rem !important;
        white-space: nowrap;
        transition: color 160ms ease, background 160ms ease;
    }

    .nav-link:hover {
        background: #f7f7f7;
        color: #ff385c;
    }

    .navbar-collapse {
        align-items: center;
    }

    .search-wrap {
        flex: 1 1 420px;
        max-width: 560px;
        min-width: 0;
    }

    .search-shell {
        position: relative;
        width: 100%;
    }

    .search-inp {
        width: 100%;
        min-height: 46px;
        border: 1px solid #dddddd;
        border-radius: 999px;
        padding: 0.78rem 7rem 0.78rem 2.9rem;
        background: #ffffff;
        box-shadow: 0 3px 12px rgba(34, 34, 34, 0.08);
    }

    .search-inp:focus {
        border-color: #ff385c;
        box-shadow: 0 0 0 4px rgba(255, 56, 92, 0.14), 0 4px 16px rgba(34, 34, 34, 0.1);
    }

    .search-icon {
        position: absolute;
        left: 1.05rem;
        top: 50%;
        z-index: 2;
        color: #717171;
        pointer-events: none;
        transform: translateY(-50%);
    }

    .search-btn {
        position: absolute;
        right: 0.35rem;
        top: 0.35rem;
        bottom: 0.35rem;
        border: 0;
        border-radius: 999px;
        padding: 0 1.15rem;
        background: #ff385c;
        color: #ffffff;
        font-size: 0.82rem;
        font-weight: 800;
        transition: background 160ms ease, transform 160ms ease;
    }

    .search-btn:hover {
        background: #e31c5f;
        color: #ffffff;
        transform: translateY(-1px);
    }

    .owner-link {
        background: #222222;
        color: #ffffff !important;
    }

    .owner-link:hover {
        background: #ff385c;
        color: #ffffff !important;
    }

    @media (max-width: 991.98px) {
        .navbar-inner {
            min-height: 68px;
        }

        .navbar-collapse {
            padding: 0.65rem 0 0.55rem;
        }

        .navbar-collapse .navbar-nav {
            width: 100%;
        }

        .search-wrap {
            width: 100%;
            max-width: none;
            margin: 0.5rem 0;
        }

        .navbar-nav .nav-link {
            display: block;
            width: 100%;
            margin: 0.15rem 0;
        }
    }

    @media (max-width: 575.98px) {
        .navbar-inner {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }

        .search-inp {
            padding-left: 2.65rem;
        }

        .search-btn {
            padding: 0 0.95rem;
        }
    }
</style>

<nav class="navbar navbar-expand-lg site-navbar border-bottom sticky-top">
    <div class="container-fluid navbar-inner px-3 px-lg-4">
        <button class="navbar-toggler border-0 shadow-none ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
            <div class="navbar-nav">
                <a class="nav-link" href="/listings"><i class="fa-solid fa-compass me-1"></i>Explore</a>
            </div>

            <div class="search-wrap mx-lg-auto">
                <form class="search-shell" role="search" action="/listings" method="GET">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input class="form-control search-inp" name="q" type="search" value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>" placeholder="Search stays, cities, or countries" aria-label="Search listings">
                    <button class="search-btn" type="submit">Search</button>
                </form>
            </div>

            <div class="navbar-nav ms-lg-auto align-items-lg-center">
                <a class="nav-link" href="/listings/new"><i class="fa-solid fa-house me-1"></i>Airbnb your home</a>
                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup"><b>Sign up</b></a>
                    <a class="nav-link owner-link" href="/login"><b>Log in</b></a>
                <% } %>
                <% if(currUser) { %>
                    <a class="nav-link owner-link" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket me-1"></i><b>Log out</b></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>
