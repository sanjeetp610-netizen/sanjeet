<% layout("/layouts/boilerplate")%>

<script>
    const mapToken = "<%= typeof mapToken !== 'undefined' ? mapToken : '' %>";
    const listing = <%- typeof listing !== 'undefined' ? JSON.stringify(listing) : '{}' %>;
</script>

<main class="listing-detail">
    <div class="listing-detail-container">
        <header class="listing-heading">
            <p class="listing-eyebrow"><i class="fa-solid fa-location-dot"></i> Stay in <%= listing.country %></p>
            <h1><%= listing.title %></h1>
        </header>

        <div>
            <article class="card show-card listing-card listing-hero">
                <img src="<%= listing.image?.url %>" class="card-img-top show-img" alt="listing_image">

                <div class="card-body listing-info">
                    <div class="listing-host">Hosted by <strong><%= listing.owner?.username || "Anonymous" %></strong></div>
                    <p class="listing-description"><%= listing.description %></p>
                    <div class="listing-facts">
                        <div><span>From</span><strong>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %><small> / night</small></strong></div>
                        <div><span>Location</span><strong><%= listing.location %>, <%= listing.country %></strong></div>
                    </div>
                </div>
            </article>
            <br>

            <% if (currUser && listing.owner && (listing.owner._id || listing.owner).toString() === (currUser._id || currUser).toString()) { %>
                <div class="btns listing-actions">
                    <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">Edit listing</a>

                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                        <button class="btn btn-outline-danger">Delete</button>
                    </form>
                </div>
            <% } %>

            <section class="listing-community">
                <% if (currUser) { %>
                    <div class="section-heading">
                        <p class="listing-eyebrow">Guest experiences</p>
                        <h2>Leave a review</h2>
                    </div>

                    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                        <div class="mb-3 mt-3">
                            <label for="rating" class="form-label">Rating</label>

                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>

                        <div class="mb-3 mt-3">
                            <label for="comment" class="form-label">Comments</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>

                            <div class="invalid-feedback">
                                Please add some comments for reviews
                            </div>
                        </div>
                        <button class="btn review-submit">Submit review</button>
                    </form>
                <% } %>

                <% if (listing.reviews && listing.reviews.length > 0) { %>
                    <section class="reviews-section">
                        <div class="section-heading"><p class="listing-eyebrow">From guests</p><h2>Reviews</h2></div>
                        <div class="row reviews-grid">
                        <% for (let review of listing.reviews) { %>
                            <% if (review) { %>
                                <% 
                                    let authorObj = review.author || review.auther;
                                    let isAuthor = currUser && authorObj && ((authorObj._id || authorObj).toString() === (currUser._id || currUser).toString());
                                %>
                                <article class="card review-card col-md-5">
                                    <div class="card-body">
                                        <h5 class="card-title">
                                            @<%= authorObj?.username || "User" %>
                                        </h5>

                                        <p class="starability-result card-text" data-rating="<%= review.rating || 1 %>"></p>

                                        <p class="card-text"><%= review.comment %></p>

                                        <% if (isAuthor) { %>
                                            <form class="mb-0" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </article>
                            <% } %>
                        <% } %>
                    </div>
                    </section>
                <% } %>

                <section class="map-section">
                    <div class="section-heading"><p class="listing-eyebrow">Explore the area</p><h2>Where you'll be</h2></div>
                    <div id="map"></div>
                </section>

                <script src="/js/map.js"></script>
            </section>
        </div>
    </div>
</main>
